# ==============================================================================
# BLACK ELEGANCE - Environment Configuration Template
# ==============================================================================

# --- Database (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=black_elegance_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/black_elegance_db

# --- Security & JWT (Admin Authentication) ---
SECRET_KEY=change_this_to_a_secure_random_key_for_production_use_only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Initial Seed Admin ---
ADMIN_EMAIL=admin@blackelegance.com
ADMIN_PASSWORD=AdminSecurePass123!
ADMIN_NAME=Black Elegance Admin

# --- SMTP Email Notifications (Order alerts for Store Owner) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@blackelegance.com
SMTP_PASSWORD=your_smtp_app_password
ADMIN_NOTIFICATION_EMAIL=owner@blackelegance.com
EMAILS_FROM_EMAIL=notifications@blackelegance.com
EMAILS_FROM_NAME=BLACK ELEGANCE

# --- Application Ports & URLs ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80
VITE_API_BASE_URL=http://localhost:8000
